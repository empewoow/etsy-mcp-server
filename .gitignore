node_modules/
build/
*.log
.env
# One settings file per Etsy shop, selected with ETSY_SETTINGS_PATH. These hold
# live keystrings, shared secrets and refresh tokens, so ignore the whole family.
# The trailing wildcard catches the .new file saveRefreshToken writes before
# renaming it into place, which holds the same secrets and would otherwise be
# the one member of the family git offers to commit.
# etsy_mcp_settings.example.json matches neither pattern and stays tracked.
etsy_mcp_settings.json*
etsy_mcp_settings_*.json*
